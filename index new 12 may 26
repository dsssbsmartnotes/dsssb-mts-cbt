function debounce(func, delay = 300) {
    let timeoutId;
    return function (...args) {
        clearTimeout(timeoutId);
        timeoutId = setTimeout(() => { func.apply(this, args); }, delay);
    };
}

async function fetchWithCache(refPath, cacheKey, expiryMinutes = 60) {
    try {
        const cached = await localforage.getItem(cacheKey);
        const cacheTime = await localforage.getItem(cacheKey + '_time');
        const now = Date.now();
        
        if (cached && cacheTime && (now - cacheTime < expiryMinutes * 60 * 1000)) {
            let parsed = null;
            try { parsed = JSON.parse(cached); } catch(e) {}
            
            // Fix: ensure cached array/object isn't null before returning
            if (parsed !== null) {
                return { 
                    exists: () => true, 
                    val: () => parsed,
                    forEach: function(cb) { 
                        if(typeof parsed === 'object') {
                            Object.entries(parsed).forEach(([k,v]) => cb({key:k, val:()=>v}));
                        }
                    }
                };
            }
        }
    } catch(e) { console.warn("Cache read issue", e); }

    try {
        const snap = await db.ref(refPath).once('value');
        if(snap && snap.exists()) {
            await localforage.setItem(cacheKey, JSON.stringify(snap.val()));
            await localforage.setItem(cacheKey + '_time', Date.now());
        }
        return snap || { exists: () => false, val: () => null, forEach: () => {} };
    } catch (error) {
        console.error("Firebase fetch error", error);
        return { exists: () => false, val: () => null, forEach: () => {} };
    }
}


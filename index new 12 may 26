async function fetchData(user) {
    try {
        if(currentUserId !== "guest") {
            const lastPresenceUpdate = sessionStorage.getItem('last_presence_update');
            const now = Date.now();
            if(!lastPresenceUpdate || (now - parseInt(lastPresenceUpdate)) > 300000) { 
                const userRef = db.ref('dsssb_presence/' + currentUserId);
                let serverTime = (typeof firebase !== 'undefined' && firebase.database && firebase.database.ServerValue) ? firebase.database.ServerValue.TIMESTAMP : now;
                userRef.update({ name: currentUser, id: currentUserId, state: 'online', lastActive: serverTime });
                userRef.onDisconnect().update({ state: 'offline', lastActive: serverTime });
                sessionStorage.setItem('last_presence_update', now);
            }
        }
        
        const [testsSnap, proSnap, notesSnap, videosSnap, resultsSnap] = await Promise.all([ 
            fetchWithCache("dsssb_tests_db", "cache_tests_v2", 1440), 
            fetchWithCache("dsssb_pro_users", "cache_pro_v2", 1440), 
            fetchWithCache("dsssb_notes_db", "cache_notes_v2", 1440),
            fetchWithCache("dsssb_videos_db", "cache_videos_v2", 1440),
            fetchWithCache("dsssb_results_live", "cache_global_leaderboard", 180) 
        ]).catch(e => {
            console.error("Promise.all error:", e);
            return [{exists:()=>false, val:()=>null}, {exists:()=>false, val:()=>null}, {exists:()=>false, val:()=>null}, {exists:()=>false, val:()=>null}, {exists:()=>false, val:()=>null}];
        });

        isPro = false;
        if(proSnap.exists()) {
            let myUsername = (user.username && user.username !== "guest") ? String(user.username).toLowerCase().trim().replace("@", "") : null;
            let myId = (user.id && user.id !== "guest") ? String(user.id).trim() : null;
            
            if (myUsername || myId) { 
                proSnap.forEach(child => {
                    let dbVal = child.val(), dbKey = String(child.key).toLowerCase().trim().replace("@", "");
                    if (!dbVal) return; 
                    
                    let v = typeof dbVal === 'object' ? (dbVal.username || dbVal.id || "") : dbVal;
                    v = String(v).toLowerCase().trim().replace("@", "");
                    
                    if (v !== "") { 
                        if ((myUsername && (v === myUsername || dbKey === myUsername)) || (myId && (v === myId || dbKey === myId))) isPro = true; 
                    } else if (dbKey !== "") { 
                        if ((myUsername && dbKey === myUsername) || (myId && dbKey === myId)) isPro = true; 
                    }
                });
            }
        }

        if(isPro) { 
            document.getElementById('badgePro').style.display = 'flex'; 
            document.getElementById('buyProBtn').style.display = 'none'; 
        } else { 
            document.getElementById('badgePro').style.display = 'none'; 
            document.getElementById('buyProBtn').style.display = 'inline-block'; 
        }

        allNotes = Object.values(notesSnap.val() || {}).reverse(); 
        allVideos = Object.values(videosSnap.val() || {}).reverse(); 
        const testData = testsSnap.val() || {}; 
        allTests = Object.keys(testData).map(key => ({ dbKey: key, ...testData[key] }));

        fetchDynamicFolders();

        if(document.getElementById('loader')) document.getElementById('loader').style.display = 'none'; 
        document.getElementById('app').style.display = 'block'; 

        const res = resultsSnap.exists() ? resultsSnap.val() : {};
        
        let unsyncedCache = await localforage.getItem('dsssb_unsynced_results');
        let unsynced = JSON.parse(unsyncedCache || '[]');
        unsynced.forEach((uRes, i) => { res['unsynced_' + i] = uRes; });
        
        let userMap = {}, myTestCount = 0, subScores = { 'Maths': [], 'English': [], 'Hindi': [], 'GK': [], 'Reasoning': [] };
        Object.values(res).forEach(r => {
            let rName = r.name || "Student", safeScore = parseFloat(r.score) || 0;
            if(!userMap[rName]) userMap[rName] = {s:0, c:0, isMe: false};
            userMap[rName].s += safeScore; 
            userMap[rName].c++;
            
            if (String(r.userId || "").trim() === String(currentUserId).trim() || rName === currentUser) {
                userMap[rName].isMe = true; 
                myTestCount++; 
                if(r.testId) attemptedTestIds.set(String(r.testId), r.time || r.timestamp || Date.now()); 
                
                let cat = r.category || (testData[r.testId] ? testData[r.testId].category : "GK");
                let max = r.testId && testData[r.testId] ? (parseInt(testData[r.testId].qs) || parseInt(testData[r.testId].marks) || 20) : 20;
                let percent = (safeScore / max) * 100;
                let matchedCat = Object.keys(subScores).find(k => cat.toLowerCase().includes(k.toLowerCase()));
                
                if(matchedCat) subScores[matchedCat].push(percent); else subScores['GK'].push(percent); 
            }
        });

        document.getElementById('valTests').innerText = myTestCount;
        let lb = Object.keys(userMap).map(k=>({name: k, avg: userMap[k].s / userMap[k].c, isMe: userMap[k].isMe})).sort((a,b) => b.avg - a.avg);
        let myRank = lb.findIndex(u => u.isMe) + 1; 
        document.getElementById('valRank').innerText = myRank > 0 ? `#${myRank}` : '--';
        
        AppState.leaderboardData = lb;

        let chartAverages = []; 
        ['Maths', 'English', 'Hindi', 'GK', 'Reasoning'].forEach(cat => { 
            let arr = subScores[cat]; 
            chartAverages.push(Math.round(arr.length > 0 ? (arr.reduce((a,b)=>a+b, 0) / arr.length) : 0)); 
        });
        
        tryRenderCharts(chartAverages);

        if (myTestCount > 0) {
            let subjects = ['Maths', 'English', 'Hindi', 'GK', 'Reasoning'];
            let weakSubject = '';
            let lowestScore = 101; 
            
            chartAverages.forEach((score, idx) => {
                if(score >= 0 && score < lowestScore) {
                    lowestScore = score;
                    weakSubject = subjects[idx];
                }
            });

            let aiCard = document.getElementById('aiRecommendationCard');
            if(weakSubject && aiCard) {
                aiCard.style.display = 'flex';
                document.getElementById('aiRecommendText').innerHTML = `<i class="fas fa-spinner fa-spin"></i> AI is analyzing your performance...`;
                document.getElementById('aiRecommendBtn').onclick = () => openExamFolder(weakSubject, true);
                
                let promptObj = `The student's mock test averages are: Maths: ${chartAverages[0]}%, English: ${chartAverages[1]}%, Hindi: ${chartAverages[2]}%, GK: ${chartAverages[3]}%, Reasoning: ${chartAverages[4]}%. Their weakest is ${weakSubject} at ${lowestScore}%. Give a very short, 1-sentence highly motivating tip in Hinglish to improve this specific subject. Do not use asterisks or markdown.`;
                
                callGemini(promptObj).then(advice => {
                    document.getElementById('aiRecommendText').innerText = advice;
                }).catch(err => {
                    document.getElementById('aiRecommendText').innerText = `Your avg in ${weakSubject} is ${lowestScore}%. Needs focus!`;
                });
            }
        }

        if (myTestCount > 0) {
            let goalCard = document.getElementById('dailyGoalCard');
            if(goalCard && !goalCard.classList.contains('completed')) {
                goalCard.classList.add('completed');
                document.getElementById('dgStatus').innerText = 'Completed ✅';
                
                if(!sessionStorage.getItem('dailyGoalCelebrated')) {
                    setTimeout(() => {
                        if(window.confetti) confetti({ particleCount: 150, spread: 80, origin: { y: 0.6 }, zIndex: 99999 });
                        showToast("Awesome! You completed your daily mock goal! 🎯");
                    }, 800);
                    sessionStorage.setItem('dailyGoalCelebrated', 'true');
                }
            }
        }

        if(Object.keys(dynamicFolders).length > 0) {
            renderDynamicFolders();
        }

        const urlParams = new URLSearchParams(window.location.search);
        const openTestId = urlParams.get('openTest');
        if (openTestId) {
            let targetTest = allTests.find(t => t.dbKey === openTestId);
            if (targetTest) {
                let isTestLocked = targetTest.type === 'pro' && !isPro;
                
                if (isTestLocked) {
                    showToast("🔒 This is a Premium Challenge. Upgrade to PRO!");
                    setTimeout(() => { document.getElementById('paymentModal').style.display = 'flex'; }, 1000);
                } else {
                    showToast("⚔️ Challenge Accepted! Redirecting...");
                    let pm = !isNaN(parseFloat(targetTest.pm)) ? parseFloat(targetTest.pm) : 1;
                    let nm = !isNaN(parseFloat(targetTest.nm)) ? parseFloat(targetTest.nm) : 0.25;
                    let isLocked = (targetTest.lock === true || targetTest.lock === "true" || targetTest.type === 'pro') ? true : false;
                    let urlQuery = `testid=${targetTest.dbKey}&title=${encodeURIComponent(targetTest.title)}&time=${targetTest.time||120}&pm=${pm}&nm=${nm}&lock=${isLocked}`;
                    
                    setTimeout(() => { window.location.href = `cbt.html?${urlQuery}&mode=exam`; }, 1500);
                }
            }
            window.history.replaceState({}, document.title, window.location.pathname);
        }

        // [FIX]: Handle race condition. Re-render UI dynamically if user opened the tab before data loaded.
        if (AppState.testsRendered && document.getElementById('tab-tests').style.display === 'block') {
            applyModernFilters();
        }
        if (AppState.studyRendered && document.getElementById('tab-study').style.display === 'block') {
            searchNotes(document.getElementById('noteSearch').value);
            renderVideos(allVideos);
        }

    } catch(e) { 
        console.error("Data Load Error:", e);
        if(document.getElementById('loader')) document.getElementById('loader').style.display = 'none'; 
        document.getElementById('app').style.display = 'block'; 
    }
}


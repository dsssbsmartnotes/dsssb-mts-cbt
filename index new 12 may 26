async function openTestLeaderboard(testId) {
    let targetTest = allTests.find(t => t.dbKey === testId);
    let testTitle = targetTest ? escapeHTML(targetTest.title) : "Mock Test Leaderboard";

    document.getElementById('rankModalTitle').innerText = "🏆 " + testTitle;
    document.getElementById('testRankModal').style.display = 'flex';
    document.getElementById('testRankBody').innerHTML = '<tr><td colspan="3" style="text-align:center; padding:20px;">Fetching Ranks... ⏳</td></tr>';

    const globalCache = await localforage.getItem("cache_global_leaderboard");
    if (globalCache) {
        try {
            let cachedResults = JSON.parse(globalCache);
            let filteredRanks = Object.values(cachedResults).filter(r => r.testId === testId);
            if (filteredRanks.length > 0) {
                processTestRankData(filteredRanks);
                return;
            }
        } catch(e) {}
    }

    db.ref("dsssb_results_live").orderByChild("testId").equalTo(testId).limitToLast(100).once("value").then(snap => {
        let rankArray = [];
        if(snap.exists()) {
            snap.forEach(child => rankArray.push(child.val()));
        }
        processTestRankData(rankArray);
    }).catch(e => {
        console.error(e);
        document.getElementById('testRankBody').innerHTML = '<tr><td colspan="3" style="text-align:center; color:red;">Error fetching rank. Please try again.</td></tr>';
    });
}

function processTestRankData(dataArray) {
    let userBest = {}; 
    dataArray.forEach(d => {
        let uid = (d.userId && d.userId !== "guest") ? d.userId : (d.name + "_" + Math.random().toString(36).substr(2, 5)); 
        let score = parseFloat(d.score) || 0;
        
        if(!userBest[uid] || userBest[uid].score < score) {
            userBest[uid] = { 
                name: d.name || 'Student', 
                score: score, 
                isMe: (String(d.userId || "").trim() === String(currentUserId).trim() || d.name === currentUser)
            };
        }
    });

    let ranks = Object.values(userBest);
    if(ranks.length === 0) {
        document.getElementById('testRankBody').innerHTML = '<tr><td colspan="3" style="text-align:center; padding: 25px 10px; color:var(--text-muted);"><i class="fas fa-rocket fa-2x" style="margin-bottom:10px;"></i><br>Be the first to attempt and rank #1! 🚀</td></tr>';
        return;
    }

    ranks.sort((a,b) => b.score - a.score);
    
    let myRankIndex = -1;
    let myData = null;
    
    ranks.forEach((r, index) => {
        if(r.isMe) {
            myRankIndex = index + 1; 
            myData = r;
        }
    });

    let html = "";
    let top5 = ranks.slice(0, 5); 
    let amIInTop5 = false;

    top5.forEach((r, i) => {
        let rankNum = i + 1;
        if(r.isMe) amIInTop5 = true;
        
        let badge = rankNum === 1 ? '<span style="font-size:18px;">🥇</span>' : 
                    rankNum === 2 ? '<span style="font-size:18px;">🥈</span>' : 
                    rankNum === 3 ? '<span style="font-size:18px;">🥉</span>' : 
                    `<div style="width:22px; height:22px; background:var(--border); border-radius:50%; display:grid; place-items:center; font-size:11px; margin:auto;">${rankNum}</div>`;
        
        let rowStyle = r.isMe ? 'background:var(--primary-light);' : '';
        let nameText = r.isMe ? `${escapeHTML(r.name)} <b style="color:var(--primary); font-size:10px;">(You)</b>` : escapeHTML(r.name);
        
        html += `<tr style="${rowStyle}">
                    <td style="width: 50px; text-align:center;">${badge}</td>
                    <td style="font-weight:700;">${nameText}</td>
                    <td style="color:var(--primary); font-weight:900;">${r.score} Pts</td>
                </tr>`;
    });

    if (myData && !amIInTop5) {
        html += `<tr><td colspan="3" style="text-align:center; color:var(--text-muted); padding:8px; font-size:18px; letter-spacing:3px;">•••</td></tr>`;
        html += `<tr style="background:var(--primary-light); border-top:2px solid var(--primary);">
                    <td style="width: 50px; text-align:center; font-weight:900;">#${myRankIndex}</td>
                    <td style="font-weight:800;">${escapeHTML(myData.name)} <b style="color:var(--primary); font-size:10px;">(You)</b></td>
                    <td style="color:var(--primary); font-weight:900;">${myData.score} Pts</td>
                </tr>`;
    } 
    else if (!myData) {
        html += `<tr><td colspan="3" style="text-align:center; color:var(--text-muted); padding:8px; font-size:18px; letter-spacing:3px;">•••</td></tr>`;
        html += `<tr>
                    <td colspan="3" style="text-align:center; padding:15px 10px; font-size:12px; font-weight:700; color:#ea580c; background:#fff7ed; border-radius:0 0 8px 8px;">
                        <i class="fas fa-lock" style="margin-right:5px;"></i> Aapne test nahi diya hai. Start Mock Test par click karein!
                    </td>
                </tr>`;
    }
    
    document.getElementById('testRankBody').innerHTML = html;
}

let dynamicFolders = {};

function fetchDynamicFolders() {
    fetchWithCache('dsssb_folders_tree', 'cache_folders_v2', 1440).then(snap => {
        if(snap.exists()) {
            dynamicFolders = snap.val();
            renderDynamicFolders();
        } else {
            document.getElementById('dynamicTreeContainer').innerHTML = `<div style="text-align:center; padding: 20px; color:var(--text-muted); width: 100%;">No Folders Found</div>`;
        }
    });
}

function renderDynamicFolders() {
        let defaultTools = `
        <div class="modern-cat-grid" style="margin-bottom: 25px;">
            <div class="modern-cat-card" onclick="openExamFolder('Live')">
                <div class="modern-cat-icon ic-red">🔴</div>
                <div class="modern-cat-name">Live Tests</div>
            </div>
            <div class="modern-cat-card" onclick="openExamFolder('Saved')">
                <div class="modern-cat-icon ic-yellow">⭐</div>
                <div class="modern-cat-name">Saved</div>
            </div>
            <div class="modern-cat-card" onclick="openExamFolder('Attempted')">
                <div class="modern-cat-icon ic-green">✅</div>
                <div class="modern-cat-name">Attempted</div>
            </div>
        </div>`;

        let folders = Object.values(dynamicFolders).sort((a,b) => (a.order || 99) - (b.order || 99));
        
        let groupedByBoard = {};
        folders.forEach(f => {
            let boardName = f.board || "Other Exams"; 
            if(!groupedByBoard[boardName]) groupedByBoard[boardName] = [];
            groupedByBoard[boardName].push(f);
        });

        let treeHtml = defaultTools;
        let isFirstBoard = true; 

        for (let board in groupedByBoard) {
            let folderCount = groupedByBoard[board].length;
            let displayState = isFirstBoard ? 'block' : 'none';
            let chevronState = isFirstBoard ? 'rotate(180deg)' : 'rotate(0deg)';
            isFirstBoard = false;

            treeHtml += `
            <div style="background: var(--bg-card); border: 1px solid var(--border); border-radius: 16px; margin-bottom: 15px; overflow: hidden; box-shadow: 0 4px 15px rgba(0,0,0,0.03);">
                <div onclick="let content = this.nextElementSibling; let icon = this.querySelector('.fa-chevron-down'); if(content.style.display === 'none'){content.style.display='block'; icon.style.transform='rotate(180deg)';}else{content.style.display='none'; icon.style.transform='rotate(0deg)';}" 
                     style="padding: 12px 15px; cursor: pointer; display: flex; justify-content: space-between; align-items: center; background: linear-gradient(to right, var(--bg-body), var(--bg-card)); border-bottom: 1px solid var(--border);">
                    
                    <div style="display:flex; align-items:center; gap:12px;">
                        <div style="background: white; width: 42px; height: 42px; border-radius: 12px; display: grid; place-items: center; font-size: 20px; box-shadow: 0 2px 6px rgba(0,0,0,0.05); border: 1px solid var(--border);">🏛️</div>
                        <div>
                            <div style="font-weight: 900; font-size: 15px; color:var(--text-main);">${escapeHTML(board)}</div>
                            <div style="font-size: 11px; color:var(--text-muted); font-weight:700;">📂 ${folderCount} Exam Categories</div>
                        </div>
                    </div>
                    <i class="fas fa-chevron-down" style="transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1); color: var(--text-muted); transform: ${chevronState}; font-size: 16px; margin-right: 5px;"></i>
                </div>

                <div style="display: ${displayState}; padding: 18px 15px; background: var(--bg-card);">
                    <div class="modern-cat-grid">`;
            
            groupedByBoard[board].forEach(f => {
                let folderData = encodeURIComponent(JSON.stringify(f)).replace(/'/g, "%27"); 
                let themeClass = "ic-blue";
                if(f.colorClass) {
                    if(f.colorClass.includes('purple')) themeClass = "ic-purple";
                    else if(f.colorClass.includes('green')) themeClass = "ic-green";
                    else if(f.colorClass.includes('orange') || f.colorClass.includes('hin')) themeClass = "ic-orange";
                    else if(f.colorClass.includes('pink') || f.colorClass.includes('eng')) themeClass = "ic-pink";
                }

                let examKey = f.examKey ? f.examKey.toLowerCase() : "";
                let categoryTests = allTests.filter(t => t.dbKey !== 'auto_qod' && ((t.category||"").toLowerCase().includes(examKey) || (t.title||"").toLowerCase().includes(examKey)));
                let totalTests = categoryTests.length;
                
                let attemptedInCat = categoryTests.filter(t => attemptedTestIds.has(String(t.dbKey)) || (t.id && attemptedTestIds.has(String(t.id)))).length;
                let realProgress = totalTests > 0 ? Math.round((attemptedInCat / totalTests) * 100) : 0;

                treeHtml += `
                <div class="modern-cat-card" onclick="openTreeFolder(JSON.parse(decodeURIComponent('${folderData}')))">
                    <div class="modern-cat-icon ${themeClass}">${f.icon || '📝'}</div>
                    <div class="modern-cat-name">${escapeHTML(f.name || 'Exam')}</div>
                    
                    <div style="font-size: 10px; font-weight: 800; color: var(--text-muted); background: var(--bg-body); padding: 2px 6px; border-radius: 6px; margin-top: -2px;">
                        ${totalTests} Mocks
                    </div>
                    
                    <div style="width: 80%; height: 5px; background: var(--bg-body); border-radius: 4px; margin-top: 6px; overflow: hidden; border: 1px solid var(--border); box-shadow: inset 0 1px 2px rgba(0,0,0,0.05);">
                        <div style="width: ${realProgress}%; height: 100%; background: var(--primary); border-radius: 4px; transition: width 0.8s cubic-bezier(0.4, 0, 0.2, 1);"></div>
                    </div>
                </div>`;
            });

            treeHtml += `</div></div></div>`;
        }

        let container = document.getElementById('dynamicTreeContainer');
        if(container) container.innerHTML = treeHtml;
}

function openTreeFolder(folderObj) {
    switchTab('tests', document.querySelector(`.nav-item[data-tab='tests']`));
    document.getElementById('testSearch').value = ''; 

    // [FIX]: Escaping single quotes within strings generated directly into onclick events 
    let safeExamKey = folderObj.examKey ? folderObj.examKey.replace(/'/g, "\\'") : '';
    let filterHtml = `<div class="filter-pill active" onclick="filterDynamicTests('${safeExamKey}', 'all', this)">All ${escapeHTML(folderObj.name)}</div>`;
    
    if(folderObj.subCategories && folderObj.subCategories.length > 0) {
        folderObj.subCategories.forEach(sub => {
            let safeSubKey = sub.filterKey ? sub.filterKey.replace(/'/g, "\\'") : '';
            filterHtml += `<div class="filter-pill" onclick="filterDynamicTests('${safeExamKey}', '${safeSubKey}', this)">${escapeHTML(sub.name)}</div>`;
        });
    }

    document.getElementById('mockFiltersRow').innerHTML = filterHtml;
    filterDynamicTests(folderObj.examKey, 'all', document.querySelector('#mockFiltersRow .filter-pill.active'));
    showToast(`Opened ${folderObj.name} 📂`);
}

function filterDynamicTests(examKey, subFilterKey, pillEl) {
    if(pillEl) { 
        document.querySelectorAll('#mockFiltersRow .filter-pill').forEach(p => p.classList.remove('active')); 
        pillEl.classList.add('active'); 
    }
    
    let list = [...allTests].reverse().filter(t => t.dbKey !== 'auto_qod');

    if (examKey && examKey !== 'all') {
        let targetExam = examKey.toLowerCase();
        list = list.filter(t => (t.category||"").toLowerCase().includes(targetExam) || (t.title||"").toLowerCase().includes(targetExam));
    }

   if (subFilterKey && subFilterKey !== 'all') {
                let targetSub = subFilterKey.toLowerCase().trim().replace(/_/g, ' ');
                list = list.filter(t => {
                    let cat = (t.category||"").toLowerCase();
                    let title = (t.title||"").toLowerCase();
                    let tags = (t.tag||"").toLowerCase() + " " + (t.tags||"").toLowerCase();
                    
                    if(targetSub.includes('full')) return cat.includes('full') || title.includes('full') || tags.includes('full');
                    if(targetSub === 'sectional') return !(cat.includes('full') || title.includes('full') || tags.includes('full'));
                    
                    return cat.includes(targetSub) || title.includes(targetSub) || tags.includes(targetSub);
                });
            }

    renderTestCards(list);
}

document.addEventListener('DOMContentLoaded', () => {
    const sliders = [document.getElementById('mockFiltersRow')];
    
    sliders.forEach(slider => {
        if(!slider) return;
        
        let isDown = false, startX, scrollLeft;
        
        slider.addEventListener('mousedown', (e) => {
            isDown = true;
            slider.style.cursor = 'grabbing';
            startX = e.pageX - slider.offsetLeft;
            scrollLeft = slider.scrollLeft;
        });
        slider.addEventListener('mouseleave', () => { 
            isDown = false; 
            if (window.innerWidth >= 1024) slider.style.cursor = 'grab'; 
        });
        slider.addEventListener('mouseup', () => { 
            isDown = false; 
            if (window.innerWidth >= 1024) slider.style.cursor = 'grab'; 
        });
        slider.addEventListener('mousemove', (e) => {
            if(!isDown) return;
            e.preventDefault();
            const x = e.pageX - slider.offsetLeft;
            const walk = (x - startX) * 2; 
            slider.scrollLeft = scrollLeft - walk;
        });
    });
});
document.addEventListener('contextmenu', function(e) { e.preventDefault(); });
document.addEventListener('keydown', function(e) {
    if (e.key === 'F12' || e.keyCode === 123) { e.preventDefault(); return false; }
    if (e.ctrlKey && e.shiftKey && ['I', 'i', 'J', 'j', 'C', 'c'].includes(e.key)) { e.preventDefault(); return false; }
    if (e.ctrlKey && ['U', 'u', 'C', 'c'].includes(e.key)) { e.preventDefault(); return false; }
});

function shareMockTest(testId, title, event) {
    if (event) event.stopPropagation();
    const shareText = `🎯 I challenge you in this Mock Test: *${title}*\n\n🔥 Let's see who gets the better rank! Attempt here:\n`;
    const baseUrl = window.location.href.split('?')[0]; 
    const shareUrl = `${baseUrl}?openTest=${testId}`;
    
    if (navigator.share) {
        navigator.share({ title: 'PYQ Notes Challenge', text: shareText, url: shareUrl })
        .catch(err => console.log("Share failed:", err));
    } else {
        navigator.clipboard.writeText(shareText + shareUrl);
        showToast("Challenge Link Copied! Send to your friends. 🏆");
    }
}

if ('serviceWorker' in navigator && window.location.protocol.startsWith('http')) {
    window.addEventListener('load', () => {
        navigator.serviceWorker.register('sw.js')
        .then(reg => console.log('Main Branch SW Registered! Scope:', reg.scope))
        .catch(err => console.error('Service Worker Error:', err));
    });
}

document.addEventListener('click', function goFullScreen() {
    if (/Android|webOS|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i.test(navigator.userAgent)) {
        let doc = window.document;
        let docEl = doc.documentElement;
        let requestFullScreen = docEl.requestFullscreen || docEl.mozRequestFullScreen || docEl.webkitRequestFullScreen || docEl.msRequestFullscreen;
        if(requestFullScreen && !doc.fullscreenElement) {
            requestFullScreen.call(docEl).catch(err => console.log("Fullscreen auto-trigger ignored by browser"));
        }
    }
    document.removeEventListener('click', goFullScreen); 
});
  
</script>

<script>
(function() {
    if (typeof firebase !== 'undefined' && firebase.apps.length > 0) {
        
        const trackDb = firebase.database();
        let trackUid = localStorage.getItem('dsssb_user_id');
        let trackUname = localStorage.getItem('dsssb_user_name') || 'Student';
        if(!trackUid) {
            trackUid = 'user_' + Math.floor(Math.random() * 1000000);
            localStorage.setItem('dsssb_user_id', trackUid);
        }

        let loc = window.location.pathname.split('/').pop() || 'index.html';
        if(loc.includes('cbt.html')) loc = 'Giving Mock Test 📝';
        else if(loc.includes('index.html') || loc === '') loc = 'On Dashboard 🏠';
        else loc = 'Exploring Portal 🔍';

        let lastTracked = localStorage.getItem('last_tracked_time');
        let nowTime = Date.now();
        let analyticsTime = (typeof firebase !== 'undefined' && firebase.database && firebase.database.ServerValue) ? firebase.database.ServerValue.TIMESTAMP : Date.now();

        if (!lastTracked || (nowTime - lastTracked > 43200000)) { 
            trackDb.ref('dsssb_analytics/users/' + trackUid).update({
                name: trackUname,
                last_active: analyticsTime
            });
            localStorage.setItem('last_tracked_time', nowTime);
        }

        const connRef = trackDb.ref('.info/connected');
        const presRef = trackDb.ref('dsssb_analytics/presence/' + trackUid);
        let isAnalyticsConnected = false;

        connRef.on('value', (snap) => {
            if (snap.val() === true && !isAnalyticsConnected) {
                isAnalyticsConnected = true;
                presRef.onDisconnect().remove();
                presRef.set({ 
                    name: trackUname, 
                    activity: loc, 
                    time: analyticsTime 
                });
            } else if (snap.val() === false) {
                isAnalyticsConnected = false;
            }
        });
    }
})();
</script>

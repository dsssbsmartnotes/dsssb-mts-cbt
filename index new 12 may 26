const apiKey = ""; 

async function callGemini(promptText, isJson = false) {
    if (!apiKey) return "API Key is missing. Please contact the administrator.";
    let payload = {
        contents: [{ parts: [{ text: promptText }] }],
        systemInstruction: { parts: [{ text: "You are an expert, friendly teacher for competitive exams. Explain concepts clearly and concisely. If responding in Hindi, use Latin script (Hinglish). If mathematical formulas are needed, wrap them in $ for inline and $$ for block." }] }
    };
    if (isJson) { payload.generationConfig = { responseMimeType: "application/json" }; }
    
    const retries = 5;
    const delays = [1000, 2000, 4000, 8000, 16000];

    for(let i = 0; i < retries; i++) {
        try {
            const response = await fetch(`https://generativelanguage.googleapis.com/v1beta/models/${AppState.aiModelString}:generateContent?key=${apiKey}`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            });
            if(!response.ok) throw new Error("API call unsuccessful");
            const result = await response.json();
            return result.candidates?.[0]?.content?.parts?.[0]?.text || "Sorry, I couldn't process that. Try again!";
        } catch (error) {
            if(i === retries - 1) return "Network error or API limit reached. Please try again later.";
            await new Promise(res => setTimeout(res, delays[i]));
        }
    }
}


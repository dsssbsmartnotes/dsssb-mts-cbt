            const checked = saved[key] ? 'checked' : '';
            const textStyle = saved[key] ? 'text-decoration: line-through; color: var(--text-muted); opacity: 0.6;' : 'text-decoration: none; color: var(--text-main); opacity: 1;';
            html += `<div class="topic-item"><input type="checkbox" class="topic-chk" onchange="updateSyllabus('${key}', this)" ${checked}><span class="topic-text" style="transition: 0.3s; ${textStyle}">${topic}</span></div>`;

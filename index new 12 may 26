async function renderNotebook(type = 'bookmarks') {
    const container = document.getElementById('bookmarksListContainer');
    let dataObj = {};
    let storageKey = type === 'bookmarks' ? 'dsssb_bookmarks' : 'dsssb_mistakes';
    let cachedData = await localforage.getItem(storageKey);
    dataObj = JSON.parse(cachedData || '{}');

    let availableSections = new Set();
    let availableTopics = new Set();

    Object.values(dataObj).forEach(q => {
        availableSections.add(q.section || "General");
        if(q.topic) availableTopics.add(q.topic);
    });

    let secSelect = document.getElementById('nbSecFilter');
    let topSelect = document.getElementById('nbTopFilter');
    
    let currSec = secSelect.value;
    let currTop = topSelect.value;
    
    let secHtml = '<option value="ALL">All Sections</option>';
    Array.from(availableSections).sort().forEach(s => secHtml += `<option value="${s}">${s}</option>`);
    let topHtml = '<option value="ALL">All Topics</option>';
    Array.from(availableTopics).sort().forEach(t => topHtml += `<option value="${t}">${t}</option>`);
    
    secSelect.innerHTML = secHtml;
    topSelect.innerHTML = topHtml;
    
    if (availableSections.has(currSec)) secSelect.value = currSec;
    if (availableTopics.has(currTop)) topSelect.value = currTop;

    let secFilter = secSelect.value;
    let topFilter = topSelect.value;

    let grouped = {};
    Object.keys(dataObj).forEach(k => {
        let q = dataObj[k];
        q._key = k;
        let sec = q.section || "General";
        let top = q.topic || "";
        
        if (secFilter !== "ALL" && sec !== secFilter) return;
        if (topFilter !== "ALL" && top !== topFilter) return;

        if(!grouped[sec]) grouped[sec] = [];
        grouped[sec].push(q);
    });

    container.innerHTML = ''; 
    
    if(Object.keys(grouped).length === 0) {
        container.innerHTML = `<div style="text-align:center; padding:50px 20px; color:var(--text-muted);">
            <div style="font-size:40px; margin-bottom:10px;">${type === 'bookmarks' ? '🔖' : '❌'}</div>
            <h3 style="color:var(--text-main);">No questions found</h3>
            <p style="font-size:13px; margin-top:8px;">Change your filters or attempt a mock to save questions.</p>
        </div>`;
        return;
    }

    const fragment = document.createDocumentFragment();

    for(let sec in grouped) {
        let secHeader = document.createElement('h3');
        secHeader.style.cssText = "color:var(--primary); border-bottom:2px solid var(--primary); padding-bottom:5px; margin-top:15px; font-size:16px;";
        secHeader.innerHTML = `${sec} <span style="font-size:12px; color:var(--text-muted); float:right; background:var(--primary-light); padding:2px 8px; border-radius:10px;">${grouped[sec].length} Qs</span>`;
        fragment.appendChild(secHeader);
        
        grouped[sec].reverse().forEach(q => {
            let correctIdx = parseInt(q.ans) - 1;
            let qText = q.q_hi || q.q_en;
            let optArr = q.op_hi || q.op_en;
            let correctAnsText = optArr && optArr[correctIdx] ? optArr[correctIdx] : "Not Specified";
            
            let topicHtml = q.topic ? `<span style="margin-left:8px; background:var(--primary-light); color:var(--primary-dark); padding:2px 6px; border-radius:4px; font-size:10px;">🏷️ ${q.topic}</span>` : '';
            let solId = `sol_${type}_${q._key}`;

            let optionsHTML = '<div style="margin-top:10px; display:flex; flex-direction:column; gap:8px;">';
            if (optArr) {
                optArr.forEach((opt, optIdx) => {
                    optionsHTML += `<div style="padding:12px 15px; border:1px solid var(--border); border-radius:10px; font-size:14px; background:var(--bg-body); color:var(--text-main);"><b>${String.fromCharCode(65+optIdx)})</b> ${opt}</div>`;
                });
            }
            optionsHTML += '</div>';

            let card = document.createElement('div');
            card.className = "test-card";
            card.style.marginBottom = "15px";
            card.style.borderLeft = `4px solid ${type==='bookmarks'?'var(--warning)':'var(--danger)'}`;
            
            card.innerHTML = `
                <div style="display:flex; justify-content:space-between; margin-bottom:12px; align-items:flex-start;">
                    <div>
                        <span style="font-size:11px; background:${type==='bookmarks'?'var(--warning)':'var(--danger)'}; color:#fff; padding:3px 8px; border-radius:6px; font-weight:800;">${type==='bookmarks'?'Saved':'Mistake'}</span>
                        ${topicHtml}
                    </div>
                    <button onclick="removeNotebookItem('${q._key}', '${type}')" style="background:none; border:none; color:var(--text-muted); cursor:pointer; font-weight:700;"><i class="fas fa-trash"></i></button>
                </div>
                <div style="font-weight:700; font-size:15px; margin-bottom:10px; line-height:1.5;">${qText}</div>
                ${optionsHTML}
                <button onclick="toggleNbSolution('${solId}', this)" style="margin-top:15px; width:100%; padding:12px; background:var(--primary-light); color:var(--primary-dark); border:1px solid var(--primary); border-radius:8px; font-weight:bold; cursor:pointer; font-size:13px; transition:0.3s;">
                    👁️ Show Answer & Solution
                </button>
                <div id="${solId}" style="display:none; background:var(--bg-body); padding:15px; border-radius:10px; border:1px solid var(--border); margin-top:10px; animation: fadeIn 0.3s;">
                    <div style="font-size:14px; font-weight:800; color:var(--success); margin-bottom:8px;">✅ Answer: ${String.fromCharCode(65+correctIdx)}) ${correctAnsText}</div>
                    <hr style="border:none; border-top:1px dashed var(--border); margin:10px 0;">
                    <div style="font-size:13px; color:var(--text-muted); line-height:1.5;"><b>💡 Detailed Solution:</b><br>${q.solution || 'No detailed solution.'}</div>
                </div>`;
                
            fragment.appendChild(card);
        });
    }
    
    container.appendChild(fragment);
    
    loadMathJax();
    renderMath([container]); 
}


        const y = new Date(); y.setDate(y.getDate()-1); 
        if(last === y.toDateString()) s++; else s = 1; 
        setSafeData('lastVisit', today); 
        setSafeData('streak', s); 
    }
    document.getElementById('valStreak').innerText = s;

    let dotsHtml = "";
    let filledDots = s > 7 ? 7 : s; 
    
    for(let i = 1; i <= 7; i++) {
        if(i <= filledDots) {
            dotsHtml += `<div style="width: 10px; height: 10px; border-radius: 50%; background: #10b981; box-shadow: 0 0 5px rgba(16, 185, 129, 0.4);"></div>`;

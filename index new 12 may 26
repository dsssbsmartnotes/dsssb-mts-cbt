                const today = new Date();
                const daysSinceEpoch = Math.floor((today.getTime() + (5.5 * 60 * 60 * 1000)) / (1000 * 60 * 60 * 24));
                const idx = daysSinceEpoch % qList.length;
                const d = qList[idx];
                
                let qText = d.q_hi || d.q_en || "Question loading...";
                let opts = d.op_hi || d.op_en || ["-", "-", "-", "-"];
                let ansIdx = parseInt(d.ans) - 1;
                
